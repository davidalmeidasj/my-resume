{
  "name": "my-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "type-check": "nuxt typecheck",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write app/ i18n/",
    "resume:build": "node resume-src/build.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.2.3",
    "@nuxtjs/sitemap": "^8.5.1",
    "nuxt": "^4.5.2",
    "vue": "^3.5.17",
    "vue3-carousel": "^0.16.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.53.1",
    "@types/node": "^22.15.32",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-plugin-oxlint": "~1.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.1.0",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.5.3",
    "serve": "^14.2.6",
    "tailwindcss": "3.4.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  },
  "lint-staged": {
    "*.{ts,mts,tsx,vue}": "eslint --fix",
    "{app,i18n}/**/*.{ts,vue,css,json}": "prettier --write"
  },
  "engines": {
    "node": "24.x"
  }
}
